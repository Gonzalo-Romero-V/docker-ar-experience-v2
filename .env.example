# Docker AR Tutor — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Required ────────────────────────────────────────────────────────────────

# OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Secret for the /ingest endpoint. The included value is enough for local use.
# Change it only when you expose the backend outside your local environment.
INGEST_SECRET=docker-ar-local-ingest-secret

# ─── Optional (defaults work for local dev) ───────────────────────────────────

# Backend port inside the container (default: 3000)
# PORT=3000
