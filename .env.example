# Docker AR Tutor — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Required ────────────────────────────────────────────────────────────────

# OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Secret for the /ingest endpoint — choose any random string
# Example: openssl rand -hex 32
INGEST_SECRET=change-me-please

# ─── Optional (defaults work for local dev) ───────────────────────────────────

# Backend port inside the container (default: 3000)
# PORT=3000
